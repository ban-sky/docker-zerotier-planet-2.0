extends network_layout

block net_content
  - const nwurl = '/controller/network/' + network.nwid
  - const networkRoutes = network.routes || []

  .card.table-card
    .table-wrap
      table.data-table
        thead
          tr
            th= t('field.target')
            th= t('field.gateway')
            th
        tbody
          each route in networkRoutes
            tr
              td.mono(data-label=t('field.target'))= route.target
              td.mono(data-label=t('field.gateway'))= route.via || '—'
              td.actions(data-label=t('field.actions'))
                a.btn.btn-sm.btn-danger(href=nwurl + '/routes/' + route.target + '/delete', data-confirm=t('confirm.deleteRoute'))= t('btn.delete')
          else
            tr
              td(colspan='3')
                .empty-inline= t('routes.empty')

  .card.form-card
    h2= t('routes.addTitle')
    form.form-stack(method='POST', action=nwurl + '/routes')
      .field
        label(for='target')= t('field.targetCidr')
        input#target(type='text', name='target', placeholder='10.42.0.0/24', value=(typeof route === 'undefined' ? '' : route.target), required)
      .field
        label(for='via')= t('field.gatewayOptional')
        input#via(type='text', name='via', placeholder='10.42.0.1', value=(typeof route === 'undefined' ? '' : (route.via || '')))
      .form-actions
        button.btn.btn-primary(type='submit')= t('btn.addRoute')
        a.btn.btn-ghost(href=nwurl)= t('btn.cancel')

  if errors
    .alert.alert-error
      ul.list-tight
        each err in errors
          li= err.msg
