extends controller_layout

block content
  .page-head
    div
      p.eyebrow= t('overview.eyebrow')
      h1= t('overview.title')
    a.btn.btn-primary(href='/controller/network/create')= t('btn.newNetwork')

  if error
    .alert.alert-error= error
  else
    .stat-grid
      .stat
        span.stat-label= t('overview.addressLabel')
        strong.mono= zt_status.address
      .stat
        span.stat-label= t('overview.versionLabel')
        strong= zt_status.version

    .card-grid
      a.card.action-card(href='/controller/networks')
        span.card-kicker= t('overview.networksKicker')
        strong= t('overview.networksTitle')
        span.card-arrow →
      a.card.action-card(href='/users')
        span.card-kicker= t('overview.accessKicker')
        strong= t('overview.accessTitle')
        span.card-arrow →
      a.card.action-card(href='/users')
        span.card-kicker= t('overview.securityKicker')
        strong= t('overview.securityTitle')
        span.card-arrow →
