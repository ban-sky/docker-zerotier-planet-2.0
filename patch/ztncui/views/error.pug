extends controller_layout

block content
  .error-page
    p.eyebrow= t('error.eyebrow')
    h1= message || t('error.fallback')
    if error && error.status
      p.error-code= 'HTTP ' + error.status
    if error && error.stack
      pre.error-stack= error.stack
    a.btn.btn-ghost(href='/controller')= t('error.backToOverview')
