extends users_layout

block users_content
  if user === null
    .alert.alert-warn= t('userDelete.noSuchUser')
  else if self_delete === true
    .alert.alert-error= t('userDelete.selfDelete')
  else if deleted
    .alert.alert-success= t('userDelete.deleted', { name: user.name })
  else
    .card.form-card
      h2= t('page.deleteUser')
      p.card-subtitle= t('userDelete.subtitle')
      form.form-stack(method='POST', action='')
        .form-actions
          button.btn.btn-danger(type='submit', name='delete', value='delete')= t('userDelete.confirmButton', { name: user.name })
          a.btn.btn-ghost(href='/users')= t('btn.cancel')

  if errors
    .alert.alert-error
      ul.list-tight
        each err in errors
          li= err.msg
