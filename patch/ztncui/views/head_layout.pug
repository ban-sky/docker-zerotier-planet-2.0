- const pageLang = (typeof htmlLang === 'string' && htmlLang) ? htmlLang : ((typeof locale === 'string' && locale) ? locale : ((typeof lang === 'string' && lang) ? lang : 'en'))

mixin nav_item(name, displayName, href)
  li(class=((navigate && navigate.active === name) ? 'is-active' : ''))
    a(href=href aria-current=((navigate && navigate.active === name) ? 'page' : false))= displayName

mixin json_value(value)
  - if ((!!value) && (value.constructor == Object || value.constructor == Array))
      code.json= JSON.stringify(value, null, 2)
  - else
      code= value

doctype html
html(lang=pageLang)
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    meta(name='color-scheme', content='light')
    title= (title || 'ZeroTier') + t('app.titleSuffix')
    link(rel='stylesheet', href='/stylesheets/app.css')
    script(src='/js/app.js', defer)
  body
    a.skip-link(href='#main')= t('a11y.skipToContent')
    header.site-header
      .container.header-inner
        a.brand(href='/')
          span.brand-mark ZT
          span.brand-copy
            strong ZeroTier
            span= t('brand.planetController')
        button.nav-toggle(type='button', aria-controls='primary-nav', aria-expanded='false', data-nav-toggle)
          span.nav-toggle-box
          span.sr-only= t('a11y.toggleNav')
        nav#primary-nav.site-nav(aria-label=t('a11y.primaryNav'))
          ul.nav-list
            block nav_items
          .nav-actions
            block nav_login
              a.nav-action(href='/logout')= t('nav.signOut')
            .nav-lang(role='group', aria-label=t('nav.language'))
              a.nav-action(href='/lang/en', hreflang='en', lang='en', aria-label=t('nav.switchToEn'))= t('nav.langEn')
              a.nav-action(href='/lang/zh-CN', hreflang='zh-CN', lang='zh-CN', aria-label=t('nav.switchToZhCn'))= t('nav.langZhCn')
    main#main
      block body_content
    footer.site-footer
      .container.footer-inner
        span= t('footer.tagline')
        span.footer-meta ZeroTier 1.16.2
