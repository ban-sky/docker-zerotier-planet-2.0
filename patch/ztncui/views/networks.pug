extends controller_layout

block content
  .page-head
    div
      p.eyebrow= t('overview.eyebrow')
      h1= t('page.networks')
    a.btn.btn-primary(href='/controller/network/create')= t('btn.newNetwork')

  if error
    .alert.alert-error= error
  else if !networks || networks.length === 0
    .empty-state
      h2= t('networks.emptyTitle')
      p= t('networks.emptyText')
      a.btn.btn-primary(href='/controller/network/create')= t('btn.createFirstNetwork')
  else
    .card.table-card
      .table-wrap
        table.data-table
          thead
            tr
              th= t('field.network')
              th.mono= t('field.networkId')
              th= t('field.actions')
          tbody
            each network in networks
              - const nwurl = '/controller/network/' + network.nwid
              tr
                td(data-label=t('field.network'))
                  a.row-title(href=nwurl)= network.name
                td.mono(data-label=t('field.networkId'))= network.nwid
                td.actions(data-label=t('field.actions'))
                  a.btn.btn-sm.btn-ghost(href=nwurl)= t('btn.details')
                  a.btn.btn-sm.btn-ghost(href=nwurl + '/easy')= t('btn.easySetup')
                  a.btn.btn-sm.btn-ghost(href=nwurl + '#members')= t('members.title')
                  a.btn.btn-sm.btn-danger(href=nwurl + '/delete', data-confirm=t('confirm.deleteNetwork'))= t('btn.delete')
