extends network_layout

block net_content
  .card
    h2= t('notImplemented.title')
    p
      = t('notImplemented.editingBefore')
      strong= title
      = t('notImplemented.editingAfter')
    if member !== undefined
      p
        a(href='/controller/network/' + network.nwid + '/member/' + (member.id || member.address))= t('notImplemented.openMember')
    p
      = t('notImplemented.settingsBefore')
      a(href='/controller/network/' + network.nwid + '#members')= t('notImplemented.membersPage')
      = t('notImplemented.settingsAfter')
