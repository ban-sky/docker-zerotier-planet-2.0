extends network_layout

block net_content
  - const nwurl = '/controller/network/' + network.nwid
  - const mode = network.v6AssignMode || {}

  .card.form-card
    h2= t('v6.title')
    p.card-subtitle= t('v6.subtitle')

    form.form-stack(method='POST', action='')
      label.check-row
        input(type='checkbox', name='6plane', value='true', checked=mode['6plane'] ? true : false)
        span
          strong= t('v6.sixPlane')
          span.check-hint= t('v6.sixPlaneHint')
      label.check-row
        input(type='checkbox', name='rfc4193', value='true', checked=mode['rfc4193'] ? true : false)
        span
          strong= t('v6.rfc4193')
          span.check-hint= t('v6.rfc4193Hint')
      label.check-row
        input(type='checkbox', name='zt', value='true', checked=mode.zt ? true : false)
        span
          strong= t('v6.fromPools')
          span.check-hint= t('v6.fromPoolsHint')

    .form-actions
      button.btn.btn-primary(type='submit')= t('btn.save')
      a.btn.btn-ghost(href=nwurl)= t('btn.cancel')

  if errors
    .alert.alert-error
      ul.list-tight
        each err in errors
          li= err.msg
