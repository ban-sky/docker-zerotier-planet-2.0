extends login_layout

block login_content
  h1.auth-title= t('frontDoor.title')
  p.auth-subtitle= t('frontDoor.subtitle')
  .auth-actions
    a.btn.btn-primary.btn-lg(href='/login')= t('btn.signIn')
    a.btn.btn-ghost.btn-lg(href='https://www.zerotier.com/download/' target='_blank' rel='noopener noreferrer')= t('frontDoor.getClient')
