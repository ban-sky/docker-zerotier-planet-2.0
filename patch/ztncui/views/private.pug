extends network_layout

block net_content
  - const nwurl = '/controller/network/' + network.nwid

  .card.form-card
    h2= t('private.title')
    p.card-subtitle= t('private.subtitle')

    form.form-stack(method='POST', action='')
      label.check-row
        input(type='checkbox', name='private', value='true', checked=network.private ? true : false, data-autosubmit)
        span
          strong= t('private.privateLabel')
          span.check-hint= t('private.privateHint')
      noscript
        button.btn.btn-primary(type='submit')= t('btn.save')
      .form-actions
        button.btn.btn-primary(type='submit')= t('btn.save')
        a.btn.btn-ghost(href=nwurl)= t('btn.cancel')

    if !network.private
      .alert.alert-warn
        strong= t('private.publicAlertTitle')
        = t('private.publicAlertBody')

  if errors
    .alert.alert-error
      ul.list-tight
        each err in errors
          li= err.msg
