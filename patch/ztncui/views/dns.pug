extends network_layout

block net_content
  - const nwurl = '/controller/network/' + network.nwid
  - const dns = network.dns || {}
  - const servers = dns.servers || []

  .card
    .card-head
      div
        h2 DNS
        p.card-subtitle= t('dns.subtitle')
      a.btn.btn-sm.btn-ghost(href=nwurl)= t('field.network')

    if !dns.domain && servers.length === 0
      p.empty-inline= t('dns.empty')
    else
      dl.detail-list
        .detail-row
          dt= t('field.domain')
          dd.mono= dns.domain || '—'
        .detail-row
          dt= t('field.servers')
          dd
            if servers.length
              each server in servers
                span.chip.mono= server
            else
              span.muted —

    form.form-stack(method='POST', action='')
      .field
        label(for='domain')= t('field.domain')
        input#domain(type='text', name='domain', value=dns.domain || '', placeholder='lab.example.com', maxlength='255')
      .field
        label(for='servers')= t('field.servers')
        textarea#servers(name='servers', rows='4', placeholder=t('dns.serversPlaceholder'))= servers.join('\n')
        p.field-hint= t('dns.hint')
      .form-actions
        button.btn.btn-primary(type='submit')= t('btn.saveDns')
        a.btn.btn-ghost(href=nwurl)= t('btn.cancel')

  if errors
    .alert.alert-error
      ul.list-tight
        each err in errors
          li= err.msg
