extends controller_layout

block content
  .page-head
    div
      p.eyebrow= t('page.networks')
      h1= t('page.createNetwork')
    a.btn.btn-ghost(href='/controller/networks')= t('btn.cancel')

  if error
    .alert.alert-error= error

  .card.form-card
    form.form-stack(method='POST', action='')
      .field
        label(for='name')= t('field.networkName')
        input#name(type='text', name='name', placeholder=t('networkCreate.namePlaceholder'), value=(typeof name === 'undefined' ? '' : name.name), maxlength='128', required, autofocus)
        p.field-hint= t('networkCreate.nameHint')
      button.btn.btn-primary(type='submit')= t('btn.createNetwork')

  if errors
    .alert.alert-error
      ul.list-tight
        each err in errors
          li= err.msg
