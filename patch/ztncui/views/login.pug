extends login_layout

block login_content
  p.eyebrow Admin access
  h1.auth-title Sign in
  p.auth-subtitle Use the one-time admin password from /app/config/admin-password inside the container. You must set a new password after the first sign-in.

  if message
    .alert.alert-info= message

  form.form-stack(method='POST', action='')
    .field
      label(for='username') Username
      input#username(type='text', name='username', autocomplete='username', placeholder='admin', required, autofocus)
    .field
      label(for='password') Password
      input#password(type='password', name='password', autocomplete='current-password', placeholder='••••••••••••', required)
    button.btn.btn-primary.btn-block(type='submit') Sign in

  p.auth-footnote
    a(href='/') Back to the planet overview
