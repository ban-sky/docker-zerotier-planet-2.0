extends login_layout

block login_content
  p.eyebrow= t('login.eyebrow')
  h1.auth-title= t('login.title')
  p.auth-subtitle= t('login.subtitle')

  if message
    .alert.alert-info= message

  form.form-stack(method='POST', action='')
    .field
      label(for='username')= t('field.username')
      input#username(type='text', name='username', autocomplete='username', placeholder='admin', required, autofocus)
    .field
      label(for='password')= t('field.password')
      input#password(type='password', name='password', autocomplete='current-password', placeholder='••••••••••••', required)
    button.btn.btn-primary.btn-block(type='submit')= t('btn.signIn')

  p.auth-footnote
    a(href='/')= t('login.backToPlanet')
