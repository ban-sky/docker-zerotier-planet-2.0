extends network_layout

block net_content
  - const nwurl = '/controller/network/' + network.nwid

  if member.deleted
    .alert.alert-success
      strong= t('memberDelete.removed', { name: member.name || member.id })
    a.btn.btn-ghost(href=nwurl + '#members')= t('btn.backToMembers')
  else
    .card.form-card
      h2= t('memberDelete.title')
      p.card-subtitle
        strong= member.name || member.id
        = t('memberDelete.willLoseAccess', { id: member.id })
      .alert.alert-warn= t('memberDelete.warning')
      form.form-stack(method='POST', action='')
        .form-actions
          button.btn.btn-danger(type='submit', name='delete', value='delete')= t('btn.removeMember')
          a.btn.btn-ghost(href=nwurl + '#members')= t('btn.cancel')

  if errors
    .alert.alert-error
      ul.list-tight
        each err in errors
          li= err.msg
