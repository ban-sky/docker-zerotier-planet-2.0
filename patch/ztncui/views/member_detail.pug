extends network_layout

block net_content
  - const nwurl = '/controller/network/' + network.nwid
  - const memberId = member.id || member.address

  .card
    .card-head
      div
        h2= member.name || memberId
        p.card-subtitle.mono= memberId
      a.btn.btn-sm.btn-ghost(href=nwurl + '#members')= t('members.title')

    dl.detail-list
      each value, key in member
        .detail-row
          dt
            a(href=nwurl + '/member/' + memberId + '/' + key)= key
          dd
            +json_value(value)

  a.btn.btn-ghost(href=nwurl + '#members')= t('btn.backToMembers')
