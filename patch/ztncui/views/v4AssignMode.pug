extends network_layout

block net_content
  - const nwurl = '/controller/network/' + network.nwid
  - const mode = network.v4AssignMode || {}

  .card.form-card
    h2= t('v4.title')
    p.card-subtitle= t('v4.subtitle')

    form.form-stack(method='POST', action='')
      label.check-row
        input(type='checkbox', name='zt', value='true', checked=mode.zt ? true : false, data-autosubmit)
        span
          strong= t('v4.autoAssign')
          span.check-hint= t('v4.autoAssignHint')

    .form-actions
      button.btn.btn-primary(type='submit')= t('btn.save')
      a.btn.btn-ghost(href=nwurl)= t('btn.cancel')

  if errors
    .alert.alert-error
      ul.list-tight
        each err in errors
          li= err.msg
