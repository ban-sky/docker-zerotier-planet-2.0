extends network_layout

block net_content
  if message
    .alert.alert-success= message

  - const routes = (network && network.routes) || []
  - const pools = (network && network.ipAssignmentPools) || []

  .card.form-card
    h2= t('easy.title')
    p.card-subtitle= t('easy.subtitle')

    form#easy-form.form-stack(method='POST', action='')
      .field
        label(for='networkCIDR')= t('field.networkCidr')
        .input-row
          input#networkCIDR(type='text', name='networkCIDR', placeholder='10.42.0.0/24', value=(routes[0] ? routes[0].target : ''), required)
          button.btn.btn-ghost(type='button', data-random-cidr)= t('btn.generate')
        p.field-hint= t('easy.cidrHint')
      .field-row
        .field
          label(for='poolStart')= t('field.poolStart')
          input#poolStart(type='text', name='poolStart', placeholder='10.42.0.1', value=(pools[0] ? pools[0].ipRangeStart : ''), required)
        .field
          label(for='poolEnd')= t('field.poolEnd')
          input#poolEnd(type='text', name='poolEnd', placeholder='10.42.0.254', value=(pools[0] ? pools[0].ipRangeEnd : ''), required)
      .form-actions
        button.btn.btn-primary(type='submit')= t('btn.applySetup')
        a.btn.btn-ghost(href='/controller/network/' + network.nwid)= t('btn.cancel')

  if errors
    .alert.alert-error
      ul.list-tight
        each err in errors
          li= err.msg
